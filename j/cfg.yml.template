# kb-chat-flow AI客服系统配置文件
# 部署时复制为 cfg.yml 并根据实际环境修改：
#   cp cfg.yml.template cfg.yml
server:
  port: 19007
  debug: true
  # 运行模式:
  #   singleton — 单例模式（默认）：内存存储 + SQLite + 本地文件，最低依赖
  #   cluster  — 集群模式：Redis + MySQL + Milvus/Qdrant + 共享存储，支持横向扩展
  mode: "singleton"
  # 服务角色（集群模式下按角色拆分部署）:
  #   all   — 全功能（默认，兼容现有行为）
  #   admin — 仅管理面：系统管理 UI + 管理写 API + 文件处理 Worker，部署 1 台
  #   chat  — 仅用户聊天面：/api/chat 等用户接口，部署 N 台挂负载均衡
  role: "all"
  # HMAC 签名密钥（用于生成和验证登录 token）:
  #   - 单例模式：留空使用默认密钥（生产环境建议设置）
  #   - 集群模式：必须设置，所有节点必须使用相同的密钥
  #   - 生成方式：openssl rand -hex 32
  # token_secret: ""

sys:
  name: 对话机器人
  auth: false

# ============================================================
# 元数据存储配置
# ============================================================
# backend 可选值:
#   sqlite — 本地 SQLite（默认，无需额外配置，启动前将 cfg.db.template 复制为 cfg.db）
#   mysql  — MySQL 数据库（需同时配置下方 mysql 段）
store:
  backend: "sqlite"

# MySQL 配置（仅 store.backend 设为 "mysql" 时需要）
mysql:
  # DSN 格式: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=Local
  # 示例:
  #   dsn: "root:123456@tcp(127.0.0.1:3306)/kb-chat-flow?charset=utf8mb4&parseTime=True&loc=Local"
  # 首次启动前需先在 MySQL 中创建数据库:
  #   CREATE DATABASE kb-chat-flow CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
  dsn: ""

# ============================================================
# 向量存储配置
# ============================================================
# backend 可选值:
#   local  — 本地 SQLite 向量存储（默认，数据文件在 ./vdb/vectors.db）
#   milvus — 远程 Milvus（需同时配置下方 milvus 段）
#   qdrant — 远程 Qdrant（需同时配置下方 qdrant 段）
vector:
  backend: "local"

# Milvus 向量数据库配置（仅 vector.backend 设为 "milvus" 时需要）
milvus:
  # Milvus 服务地址（留空则回退为本地存储）
  # 示例: "http://localhost:19530"
  uri: ""
  # Milvus 认证 token（可选）
  token: ""

# Qdrant 向量数据库配置（仅 vector.backend 设为 "qdrant" 时需要）
qdrant:
  # Qdrant 服务地址
  host: "localhost"
  # gRPC 端口（默认为 6334，Qdrant Cloud 通常使用 443）
  port: 6334
  # API Key（Qdrant Cloud 需要，本地部署可留空）
  api_key: ""
  # 是否启用 TLS（Qdrant Cloud 建议开启）
  use_tls: false

# ============================================================
# Redis 配置（仅 server.mode 设为 "cluster" 时需要）
# ============================================================
redis:
  # Redis 服务地址
  addr: "localhost:6379"
  # Redis 密码（可选，留空表示无密码）
  password: ""
  # Redis 数据库编号（默认 0）
  db: 0

# ============================================================
# 对象存储配置（仅 server.mode 设为 "cluster" 时需要）
# ============================================================
oss:
  # 存储类型: "minio" | "s3" | "aliyun"
  type: "minio"
  # 存储服务地址
  endpoint: "localhost:9000"
  # 访问密钥
  access_key: ""
  secret_key: ""
  # Bucket 名称
  bucket: "kb-chat-flow"

